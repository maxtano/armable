{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "esModuleInterop": true, "isolatedModules": true,
    "types": ["vite/client", "node", "w3c-web-serial", "w3c-web-usb"], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "scripts", "server", "e2e", "vite.config.ts", "vite.panel.config.ts"]
}
